===# متغيرات البيئة — انسخ هذا الملف إلى .env وعدّل القيم

# منفذ الخادم
PORT=3001

# مفتاح JWT السري — استخدم قيمة عشوائية طويلة (32+ حرف) في الإنتاج
# مثال لتوليد قيمة: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_IN_PRODUCTION

# مسار ملف قاعدة البيانات SQLite
DATABASE_PATH=./data/gm-pos.db

# تُستخدم عند تشغيل `pnpm seed` محليًا فقط. لا تضع أي كلمات مرور حقيقية في هذا الملف.
SEED_SUPER_ADMIN_PASSWORD=hassen2007
SEED_MANAGER_PASSWORD=hassen2007
